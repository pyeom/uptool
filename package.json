{
  "name": "uptool",
  "version": "0.4.0",
  "description": "Serve LLM-generated HTML files via wildcard subdomains on your own domain",
  "type": "commonjs",
  "bin": {
    "uptool": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "author": "pyeom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyeom/uptool.git"
  },
  "homepage": "https://github.com/pyeom/uptool#readme",
  "bugs": {
    "url": "https://github.com/pyeom/uptool/issues"
  },
  "scripts": {
    "build": "npm run typecheck && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run build && vitest run --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "cloudflared": "^0.7.3",
    "commander": "^12.1.0",
    "marked": "^18.0.9",
    "qrcode-terminal": "^0.12.0",
    "smol-toml": "^1.3.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "html",
    "serve",
    "llm",
    "subdomain",
    "cli"
  ],
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
